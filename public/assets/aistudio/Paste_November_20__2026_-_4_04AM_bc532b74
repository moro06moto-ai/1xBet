                        return p.account_id.includes(inputVal) || 
                               p.promo_code.toLowerCase().includes(inputVal.toLowerCase()) || 
                               p.player_name.includes(inputVal) ||
                               p.country.includes(inputVal);
                    }
                });
            }

            loading.classList.add('hidden');

            if (results.length === 0) {
                noResults.classList.remove('hidden');
                document.getElementById('resultsCountBadge').textContent = '0 نتائج مطابقة';
            } else {
                noResults.classList.add('hidden');
                document.getElementById('resultsCountBadge').textContent = `تم العثور على ${results.length} نتيجة`;
                renderResultsGrid(results);
            }

            // Sync Table Filters to show searched results too
            filteredPlayers = results;
            currentPage = 1;
            renderTable();

            // Scroll down smoothly to results
            document.getElementById('resultsSection').scrollIntoView({ behavior: 'smooth' });
        }

        // Render Search Cards
        function renderResultsGrid(items) {
            const grid = document.getElementById('resultsGrid');
            grid.innerHTML = '';

            items.forEach(player => {
                const isCompleted = player.download_status === "مكتمل";
                
                let statusBadgeClass = "bg-gray-700/50 text-gray-300 border-gray-600";
                let statusIcon = "fa-clock";
                
                if (player.download_status === "مكتمل") {
                    statusBadgeClass = "bg-emerald-500/20 text-emerald-400 border-emerald-500/40";
                    statusIcon = "fa-circle-check";
                } else if (player.download_status === "جارٍ التحميل") {
                    statusBadgeClass = "bg-amber-500/20 text-amber-400 border-amber-500/40";
                    statusIcon = "fa-spinner animate-spin";
                } else if (player.download_status === "فشل") {
                    statusBadgeClass = "bg-rose-500/20 text-rose-400 border-rose-500/40";
                    statusIcon = "fa-circle-xmark";
                }

                const cardHtml = `
                    <div class="bg-darkbg-800 rounded-2xl border border-gray-800 hover:border-brand-500/50 p-5 space-y-4 transition-all hover:shadow-xl relative flex flex-col justify-between">
                        <div>
                            <!-- Header Bar -->
                            <div class="flex items-center justify-between border-b border-gray-700/60 pb-3 mb-3">
                                <div class="flex items-center gap-2">
                                    <div class="w-8 h-8 rounded-lg bg-brand-500/20 text-brand-400 flex items-center justify-center font-bold">
                                        <i class="fa-solid fa-user-check text-sm"></i>
                                    </div>
                                    <div>
                                        <h3 class="font-bold text-white text-sm sm:text-base">${player.player_name}</h3>
                                        <span class="text-xs text-gray-400 font-mono">ID: ${player.account_id}</span>
                                    </div>
                                </div>
                                <span class="px-2.5 py-1 rounded-full text-xs font-bold border ${statusBadgeClass} flex items-center gap-1.5">
                                    <i class="fa-solid ${statusIcon}"></i>
                                    ${player.download_status}
                                </span>
                            </div>

                            <!-- Details Grid -->
                            <div class="grid grid-cols-2 gap-2 text-xs text-gray-300">
                                <div class="bg-darkbg-900/60 p-2 rounded-xl border border-gray-800">
                                    <span class="text-gray-500 block text-[10px]">الشركة</span>
                                    <span class="font-bold text-white">${player.company}</span>
                                </div>
                                <div class="bg-darkbg-900/60 p-2 rounded-xl border border-gray-800">
                                    <span class="text-gray-500 block text-[10px]">البرومو كود</span>
                                    <span class="font-bold text-amber-400 font-mono">${player.promo_code}</span>
                                </div>
                                <div class="bg-darkbg-900/60 p-2 rounded-xl border border-gray-800">
                                    <span class="text-gray-500 block text-[10px]">الرصيد/الفئة</span>
                                    <span class="font-bold text-emerald-400 font-mono">${player.amount}</span>
                                </div>
                                <div class="bg-darkbg-900/60 p-2 rounded-xl border border-gray-800">
                                    <span class="text-gray-500 block text-[10px]">الدولة</span>
                                    <span class="font-bold text-white">${player.country}</span>
                                </div>
                            </div>

                            <!-- Keyword Tag -->
                            <div class="mt-3 bg-darkbg-900 p-2 rounded-xl border border-gray-800 text-[11px] text-gray-400 flex items-center gap-1.5">
                                <i class="fa-solid fa-key text-brand-500"></i>
                                <span>الكلمة المفتاحية:</span>
                                <strong class="text-gray-200">${player.keyword}</strong>
                            </div>
                        </div>

                        <!-- Action Download Button (Only visible when URL present) -->
                        <div class="pt-2 border-t border-gray-800/80">
                            ${isCompleted && player.download_url ? `
                                <a href="${player.download_url}" target="_blank" rel="noopener noreferrer" class="w-full py-2.5 px-4 bg-gradient-to-r from-emerald-600 to-teal-500 hover:from-emerald-500 hover:to-teal-600 text-white text-xs font-bold rounded-xl shadow-lg transition-all flex items-center justify-center gap-2 group">
                                    <i class="fa-solid fa-download group-hover:bounce"></i>
                                    <span>تحميل السكربت الموثق (رابط مصرح)</span>
                                </a>
                            ` : `
                                <button disabled class="w-full py-2.5 px-4 bg-darkbg-900 text-gray-500 text-xs font-bold rounded-xl border border-gray-800 cursor-not-allowed flex items-center justify-center gap-2">
                                    <i class="fa-solid fa-lock"></i>
                                    <span>التنزيل غير متاح (يتطلب استكمال التوثيق)</span>
                                </button>
                            `}
                        </div>
                    </div>
                `;
                grid.innerHTML += cardHtml;
            });
        }

        // Table Render Logic
        function renderTable() {
            const tbody = document.getElementById('tableBody');
            tbody.innerHTML = '';

            const startIdx = (currentPage - 1) * pageSize;
            const endIdx = startIdx + pageSize;
            const pageData = filteredPlayers.slice(startIdx, endIdx);

            if (pageData.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="9" class="p-8 text-center text-gray-400">
                            لا توجد سجلات مطابقة للفلاتر المحددة حالياً.
                        </td>
                    </tr>
                `;
            } else {
                pageData.forEach(p => {
                    const isCompleted = p.download_status === "مكتمل";
                    
                    let badgeClass = "bg-gray-800 text-gray-300";
                    if (p.download_status === "مكتمل") badgeClass = "bg-emerald-500/20 text-emerald-400 border border-emerald-500/30";
                    else if (p.download_status === "جارٍ التحميل") badgeClass = "bg-amber-500/20 text-amber-400 border border-amber-500/30";
                    else if (p.download_status === "فشل") badgeClass = "bg-rose-500/20 text-rose-400 border border-rose-500/30";

                    const tr = document.createElement('tr');
                    tr.className = "hover:bg-darkbg-700/40 transition-colors";
                    tr.innerHTML = `
                        <td class="p-3.5 font-bold text-white">${p.player_name}</td>
                        <td class="p-3.5 font-mono text-brand-400">${p.account_id}</td>
                        <td class="p-3.5">${p.company}</td>
                        <td class="p-3.5 font-mono text-amber-300">${p.promo_code}</td>
                        <td class="p-3.5 font-mono text-emerald-400">${p.amount}</td>
                        <td class="p-3.5">${p.country}</td>
                        <td class="p-3.5">
                            <span class="px-2 py-0.5 rounded-full text-[11px] font-bold ${badgeClass}">
                                ${p.download_status}
                            </span>
                        </td>
                        <td class="p-3.5 font-mono text-gray-400 text-xs">${p.verified_at}</td>
                        <td class="p-3.5 text-center">
                            ${isCompleted && p.download_url ? `
                                <a href="${p.download_url}" target="_blank" class="px-3 py-1 bg-brand-600 hover:bg-brand-500 text-white rounded-lg text-xs font-bold transition-colors inline-flex items-center gap-1">
                                    <i class="fa-solid fa-download"></i>
                                    <span>تحميل</span>
                                </a>
                            ` : `
                                <span class="text-gray-600 text-xs font-semibold">غير متاح</span>
                            `}
                        </td>
                    `;
                    tbody.appendChild(tr);
                });
            }

            // Update Pagination Controls
            const totalPages = Math.ceil(filteredPlayers.length / pageSize) || 1;
            document.getElementById('currentPageNum').textContent = currentPage;
            document.getElementById('totalPagesNum').textContent = totalPages;
            document.getElementById('totalFilteredText').textContent = filteredPlayers.length;
            
            const startDisplay = filteredPlayers.length === 0 ? 0 : startIdx + 1;
            const endDisplay = Math.min(endIdx, filteredPlayers.length);
            document.getElementById('pageRangeText').textContent = `${startDisplay} - ${endDisplay}`;

            document.getElementById('prevPageBtn').disabled = (currentPage === 1);
            document.getElementById('nextPageBtn').disabled = (currentPage >= totalPages);
        }

        // Apply Table Filters
        function applyTableFilters() {
            const countryVal = document.getElementById('countryFilter').value;
            const statusVal = document.getElementById('statusFilter').value;

            filteredPlayers = playersDB.filter(p => {
                const matchCountry = (countryVal === 'ALL' || p.country === countryVal);
                const matchStatus = (statusVal === 'ALL' || p.download_status === statusVal);
                return matchCountry && matchStatus;
            });

            currentPage = 1;
            renderTable();
        }

        function changePage(direction) {
            currentPage += direction;
            renderTable();
        }

        function changePageSize() {
            pageSize = parseInt(document.getElementById('pageSizeSelect').value, 10);
            currentPage = 1;
            renderTable();
        }

        function resetSearchAndFilters() {
            filteredPlayers = [...playersDB];
            document.getElementById('countryFilter').value = 'ALL';
            document.getElementById('statusFilter').value = 'ALL';
            document.getElementById('searchInput').value = '';
            document.getElementById('clearBtn').classList.add('hidden');
            hideValidationAlert();
            currentPage = 1;
            renderResultsGrid(playersDB.slice(0, 6));
            renderTable();
            document.getElementById('resultsCountBadge').textContent = 'عرض جميع السجلات (250)';
        }

        // Update Dynamic Header Statistics
        function updateStatsCards() {
            document.getElementById('statTotalPlayers').textContent = playersDB.length;
            document.getElementById('statCompanies').textContent = "1xBet";
            document.getElementById('statCountries').textContent = `${ARABIC_COUNTRIES.length} دولة`;
            document.getElementById('statVerified').textContent = `${playersDB.length} (100%)`;
            document.getElementById('dbTotalBadge').textContent = playersDB.length;
        }

        // FAQ Accordion Toggle Function
        function toggleFaq(id) {
            const content = document.getElementById(`faqContent-${id}`);
            const icon = document.getElementById(`faqIcon-${id}`);

            if (content.classList.contains('hidden')) {
                content.classList.remove('hidden');
                icon.classList.add('rotate-180');
            } else {
                content.classList.add('hidden');
                icon.classList.remove('rotate-180');
            }
        }

        // Toggle API Live Simulation Mode
        function toggleApiMode() {
            isLiveApiMode = !isLiveApiMode;
            const btn = document.getElementById('toggleApiBtn');
            const icon = document.getElementById('apiIcon');
            const txt = document.getElementById('apiStatusText');

            if (isLiveApiMode) {
                btn.classList.replace('bg-darkbg-700', 'bg-brand-600/20');
                btn.classList.replace('border-gray-700', 'border-brand-500');
                icon.classList.replace('fa-toggle-off', 'fa-toggle-on');
                icon.classList.replace('text-gray-400', 'text-brand-500');
                txt.textContent = "وضع الاتصال الحي بـ API / GitLab";
                showToast("تم تفعيل وضع الاتصال المباشر بـ GitLab API Endpoint");
            } else {
                btn.classList.replace('bg-brand-600/20', 'bg-darkbg-700');
                btn.classList.replace('border-brand-500', 'border-gray-700');
                icon.classList.replace('fa-toggle-on', 'fa-toggle-off');
                icon.classList.replace('text-brand-500', 'text-gray-400');
                txt.textContent = "وضع البيانات المحلية (250)";
                showToast("تم العودة إلى وضع قاعدة البيانات المحلية المضمنة");
            }
        }

        // Toast Helper
        function showToast(msg) {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toastMsg');
            toastMsg.textContent = msg;
            toast.classList.remove('translate-y-20', 'opacity-0');
            
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }
    </script>
</body>
</html>